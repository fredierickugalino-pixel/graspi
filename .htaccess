Options -MultiViews
RewriteEngine On
RewriteBase /newlogin/

# Redirect direct requests for role PHP pages to their clean role-page URLs.
RewriteCond %{THE_REQUEST} \s/+newlogin/(admin|teacher|student|registrar)/([^?\s]+)\.php(?:[?\s]) [NC]
RewriteRule ^(admin|teacher|student|registrar)/(.+)\.php$ $1-$2 [R=308,L,NE]

# Serve /admin-page, /teacher-page, and /student-page from the existing files.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(admin|teacher|student|registrar)-([A-Za-z0-9_-]+)$ $1/$2.php [L,QSA]
